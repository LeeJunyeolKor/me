    "fastify": "^5.12.7",
    "fastify-cli": "^7.4.1",
    "fastify-plugin": "^5.1.0"
  },
  "devDependencies": {
    "dotenv": "^16.6.1",
    "glob": "^10.5.0",
    "tsx": "^4.23.15"
  }
